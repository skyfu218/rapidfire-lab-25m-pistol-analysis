{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", ".git/**", "README.md", "AGENTS.md"],
    "headers": [{"source":"**/*.@(js|css)","headers":[{"key":"Cache-Control","value":"public,max-age=3600"}]}],
    "rewrites": [{"source":"**","destination":"/index.html"}]
  }
}
